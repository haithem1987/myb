# Environment Configuration File
# Copy this file to .env and update the values for your environment

# ==================================================
# OVH CLOUD INFRASTRUCTURE
# ==================================================
# Required for: terraform apply, ovh-infra-*.sh scripts
# Get from: https://api.ovh.com/createToken/
# Docs: docs/OVH_CREDENTIALS_SETUP.md
OVH_APPLICATION_KEY=your-app-key-here
OVH_APPLICATION_SECRET=your-app-secret-here
OVH_CONSUMER_KEY=your-consumer-key-here
OVH_ENDPOINT=ovh-eu

# ==================================================
# NODE/FRONTEND
# ==================================================
NODE_ENV=production

# ==================================================
# DOTNET SERVICES
# ==================================================
ASPNETCORE_ENVIRONMENT=Development

# ==================================================
# KEYCLOAK
# ==================================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=MYB-client
KEYCLOAK_CLIENT_SECRET=f4umyKKCMYgaipA3f3MndHeTg8ubvyD2
KEYCLOAK_BASE_URL=http://keycloak:8080/realms/MYB/protocol/openid-connect
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/MYB
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-pwd

# ==================================================
# DATABASE CONFIGURATION
# ==================================================

# Timesheet Database
TIMESHEET_DB_NAME=timesheetDB
TIMESHEET_DB_USER=postgres
TIMESHEET_DB_PASSWORD=timesheet-pwd

# Document Database
DOCUMENT_DB_NAME=documentDB
DOCUMENT_DB_USER=postgres
DOCUMENT_DB_PASSWORD=document-pwd

# Invoice Database
INVOICE_DB_NAME=invoiceDB
INVOICE_DB_USER=postgres
INVOICE_DB_PASSWORD=invoice-pwd

# ==================================================
# EXTERNAL SERVICES
# ==================================================

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_test_dummy_key
STRIPE_PUBLISHABLE_KEY=pk_test_dummy_key

# SendGrid Email Service
SENDGRID_API_KEY=sg_test_dummy_key
EMAIL_FROM_ADDRESS=noreply@myb.com

# ==================================================
# SMTP CONFIGURATION
# ==================================================
# Dev (Mailhog — no auth, no TLS):
#   SMTP_HOST=mailhog
#   SMTP_PORT=1025
#
# Gmail (App Password — STARTTLS on 587):
#   1. Enable 2FA on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password for "Mail"
#   4. Use the 16-char password below
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_ENABLE_SSL=false
SMTP_USERNAME=benmaadnidhal96@gmail.com
SMTP_PASSWORD=jfqrysgrmshbqkfy
EMAIL_FROM_ADDRESS=benmaadnidhal96@gmail.com
SMTP_FROM_NAME=MYB Platform

# ==================================================
# KEYCLOAK REALM
# ==================================================
KEYCLOAK_REALM=MYB
