# ─────────────────────────────────────────────────────────────────
# MYB Coproperty - GCP Environment Variables
# Copy this file to .env.gcp and fill in your values
# ─────────────────────────────────────────────────────────────────

# ─── GCP Project ─────────────────────────────────────────────────
GCP_PROJECT_ID=manage-your-business-493909
GCP_REGION=europe-west1
GCP_ZONE=europe-west1-b
IMAGE_TAG=latest

# ─── Keycloak Admin ─────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Keycloak DB ─────────────────────────────────────────────────
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-pwd

# ─── Coproperty DB ───────────────────────────────────────────────
COPROPERTY_DB_NAME=copropertyDB
COPROPERTY_DB_USER=postgres
COPROPERTY_DB_PASSWORD=coproperty-pwd

# ─── Keycloak OAuth ─────────────────────────────────────────────
KEYCLOAK_CLIENT_ID=MYB-client
KEYCLOAK_CLIENT_SECRET=f4umyKKCMYgaipA3f3MndHeTg8ubvyD2
KEYCLOAK_SERVICE_CLIENT_ID=myb-backend
KEYCLOAK_SERVICE_CLIENT_SECRET=Iae91CtN9N1a3voLVYW4yFsaA7woSTDD
KEYCLOAK_MANAGER_ROLE=coproperty-syndic
KEYCLOAK_REALM=MYB

# ─── URLs (update after deployment) ─────────────────────────────
# External URL where Keycloak is reachable from browsers
KEYCLOAK_EXTERNAL_URL=http://YOUR_VM_EXTERNAL_IP:8080
# Internal URL for service-to-service communication
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# ─── RabbitMQ ────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── ASP.NET ─────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
