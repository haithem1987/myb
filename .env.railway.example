# ====================================
# Railway Environment Variables for MYB Project
# ====================================
# 
# How to use:
# 1. Copy these variables to Railway Dashboard
# 2. Replace <secure-password> with actual passwords
# 3. Replace ${{service.VARIABLE}} with Railway references
# 4. Never commit actual passwords to Git
#
# Railway Dashboard: https://railway.app/dashboard
#
# ====================================

# ====================================
# SERVICE: keycloak-db (PostgreSQL)
# ====================================
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=<secure-keycloak-db-password>

# ====================================
# SERVICE: coproperty-db (PostgreSQL)
# ====================================
POSTGRES_DB=copropertyDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<secure-coproperty-db-password>

# ====================================
# SERVICE: keycloak
# ====================================

# Admin credentials
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<secure-admin-password>
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<secure-admin-password>

# Database connection (use Railway's private network)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://${{keycloak-db.RAILWAY_PRIVATE_DOMAIN}}:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=<same-as-keycloak-db-password>

# Keycloak runtime settings
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_PROXY=edge
KC_HOSTNAME_STRICT_HTTPS=false

# ====================================
# SERVICE: myb-coproperty (Backend)
# ====================================

# ASP.NET Core settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Database connection (use Railway's private network)
ConnectionStrings__CopropertyDBConnection=Host=${{coproperty-db.RAILWAY_PRIVATE_DOMAIN}};Port=5432;Database=copropertyDB;Username=postgres;Password=<coproperty-db-password>

# Keycloak integration (use Railway's public domain for Keycloak)
Keycloak__Authority=https://${{keycloak.RAILWAY_PUBLIC_DOMAIN}}/realms/MYB
Keycloak__BaseUrl=https://${{keycloak.RAILWAY_PUBLIC_DOMAIN}}/realms/MYB/protocol/openid-connect
Keycloak__ClientId=MYB-client
Keycloak__ClientSecret=f4umyKKCMYgaipA3f3MndHeTg8ubvyD2

# Logging (optional)
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning

# ====================================
# SERVICE: myb-admin (Frontend)
# ====================================

# Build & Runtime
NODE_ENV=production
PORT=8080

# ====================================
# RAILWAY-SPECIFIC NOTES
# ====================================
#
# Railway Variable Reference Syntax:
# - ${{service-name.RAILWAY_PRIVATE_DOMAIN}} = Internal hostname (for service-to-service)
# - ${{service-name.RAILWAY_PUBLIC_DOMAIN}}  = Public HTTPS URL
# - ${{env.VARIABLE_NAME}}                   = Shared environment variable
#
# Example:
# - Private: myb-coproperty.railway.internal
# - Public:  myb-coproperty-production.up.railway.app
#
# Important:
# 1. Use RAILWAY_PRIVATE_DOMAIN for database connections (faster, secure)
# 2. Use RAILWAY_PUBLIC_DOMAIN for external URLs (web, OAuth redirects)
# 3. All passwords should be strong (min 16 chars, mixed case, symbols)
# 4. Change default passwords immediately after first deployment
#
# ====================================

# ====================================
# PASSWORD GENERATION EXAMPLES
# ====================================
#
# Generate secure passwords using:
#
# macOS/Linux:
# openssl rand -base64 32
#
# Or use a password manager like:
# - 1Password
# - LastPass
# - Bitwarden
#
# ====================================

# ====================================
# QUICK DEPLOYMENT CHECKLIST
# ====================================
#
# Before deploying to Railway:
#
# [ ] Set POSTGRES_PASSWORD for keycloak-db
# [ ] Set POSTGRES_PASSWORD for coproperty-db
# [ ] Set KC_BOOTSTRAP_ADMIN_PASSWORD
# [ ] Set KEYCLOAK_ADMIN_PASSWORD (same as above)
# [ ] Set KC_DB_PASSWORD (same as keycloak-db password)
# [ ] Update Keycloak__ClientSecret if changed
# [ ] Verify Dockerfile path for myb-admin = "Dockerfile.frontend"
# [ ] Verify Dockerfile path for myb-coproperty = "src/services/coproperty-management/Myb.Coproperty/Dockerfile"
# [ ] Set Keycloak start command = "start --db=postgres"
#
# ====================================

# ====================================
# SERVICE URLs (After Deployment)
# ====================================
#
# Update these after Railway assigns domains:
#
# Admin Panel:    https://myb-admin-production.up.railway.app
# Backend API:    https://myb-coproperty-production.up.railway.app/graphql
# Keycloak:       http://localhost:4200
#
# ====================================
