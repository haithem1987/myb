# Multi-stage build for Admin Frontend app
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files from frontend directory
COPY src/front/myb.front/package.json src/front/myb.front/package-lock.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy NX workspace
COPY src/front/myb.front/ ./

# Build admin app with NX for OVHCloud production
RUN npx nx build admin --configuration=ovhcloud

# Production stage - Use nginx for better performance  
FROM nginx:alpine

# Write default nginx config (will be overridden by K8s configmap mount at runtime)
RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location = /admin { \
        return 302 /admin/; \
    } \
    location /admin/ { \
        try_files $uri $uri/ /admin/index.html; \
    } \
    location / { \
        return 302 /admin/; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Keep the files under /admin to match the Angular base href and ingress path.
COPY --from=builder /app/dist/apps/admin /usr/share/nginx/html/admin

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
