FROM quay.io/keycloak/keycloak:23.0.4

# Copy custom MYB theme into the Keycloak themes directory
COPY keycloak-theme/ /opt/keycloak/themes/

# Set environment defaults for production
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_HTTP_ENABLED=true
ENV KC_HOSTNAME_STRICT=false
ENV KC_PROXY=edge
ENV KC_HTTP_PORT=8080

# Expose port
EXPOSE 8080

# Use the official image's entrypoint
# Start in production mode with optimized database
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--db=postgres"]
