# Multi-stage build for Angular production
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY nx.json ./
COPY tsconfig*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build admin and client apps
ARG KEYCLOAK_URL
ARG API_URL

ENV KEYCLOAK_URL=${KEYCLOAK_URL}
ENV API_URL=${API_URL}

RUN npx nx build admin --configuration=production
RUN npx nx build client --configuration=production

# =============================================================================
# Production stage with Nginx
# =============================================================================
FROM nginx:alpine

# Copy built apps
COPY --from=builder /app/dist/apps/admin /usr/share/nginx/html/admin
COPY --from=builder /app/dist/apps/client /usr/share/nginx/html/client

# Copy nginx configuration
COPY nginx.prod.conf /etc/nginx/nginx.conf

# Expose port 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
